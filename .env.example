# ── Admik Storefront API ──
# Витрина — headless-потребитель публичного API Admik (/api/storefront/v1/*).
# Своей БД/заказов/СДЭК/почты у витрины нет — всё на стороне Admik.

# Адрес бэкенда Admik для server components / server actions (запросы внутри
# docker-сети). В проде по умолчанию — имя сервиса Admik в compose-сети:
ADMIK_API_URL="http://app:3000"

# Публичный адрес API Admik для клиента (checkout, автокомплит городов СДЭК).
# ВАЖНО: NEXT_PUBLIC_* вшивается в клиентский бандл на этапе сборки, поэтому
# задаётся как build-arg Docker (NEXT_PUBLIC_ADMIK_API_URL), напр.:
NEXT_PUBLIC_ADMIK_API_URL="https://admin.shop.ru"

# Ключ витрины (выдаётся в Admik: STOREFRONT_API_KEYS). Если Admik настроен на
# Origin-allowlist, ключ можно не задавать; в dev/mock доступ открыт. (опц.)
STOREFRONT_API_KEY=""

# ── Site ──
# Публичный адрес витрины (metadata, canonical, checkout-редиректы):
NEXT_PUBLIC_SITE_URL="https://shop.ru"
