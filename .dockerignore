# =============================================================================
# THE CASE (витрина) — .dockerignore
# Исключаем из контекста сборки всё, что не нужно образу (ускоряет билд и
# уменьшает контекст). Зависимости и сборка делаются внутри образа.
# =============================================================================

# Зависимости и сборка (ставятся/собираются внутри Dockerfile)
node_modules
.next
out
build
dist

# Git и история
.git
.gitignore
.gitattributes

# Секреты и локальное окружение (НИКОГДА не попадают в образ)
.env
.env.local
.env.*.local
*.pem
*.key

# Документация и журнал проекта
README.md
*.md

# Тесты и покрытие
coverage
*.tsbuildinfo

# Инфраструктурные конфиги (не нужны рантайму/сборке)
Dockerfile
.dockerignore

# Исходные ассеты и локальные скрипты обработки картинок:
# в образ попадает только готовый public/, а сырьё обрабатывается локально.
Брендбук
Референсы
Фото
scripts/process-foto.mjs
scripts/process-images.mjs

# Конфиги редакторов / ОС
.idea
.vscode
.DS_Store
Thumbs.db

# Логи
*.log

# Агентские настройки Claude
.claude
