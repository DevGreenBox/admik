# =============================================================================
# Admik — Caddyfile (reverse-proxy с авто-SSL)
# =============================================================================
# Caddy проксирует трафик на контейнер приложения app:3000.
# Домен берётся из переменной окружения SHOP_DOMAIN (.env).
# Если SHOP_DOMAIN задан как реальный домен — Caddy автоматически получит
# бесплатный TLS-сертификат Let's Encrypt (HTTPS из коробки).
# =============================================================================

# Глобальные настройки Caddy
{
	# Email для уведомлений Let's Encrypt (необязательно, но рекомендуется).
	email {$ACME_EMAIL}
}

# -----------------------------------------------------------------------------
# Сниппет с security-заголовками (переиспользуется в каждом сайте)
# -----------------------------------------------------------------------------
(security_headers) {
	header {
		# Принудительный HTTPS на год + поддомены (HSTS)
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		# Запрет угадывания MIME-типов
		X-Content-Type-Options "nosniff"
		# Защита от кликджекинга
		X-Frame-Options "SAMEORIGIN"
		# Базовая referrer-политика
		Referrer-Policy "strict-origin-when-cross-origin"
		# Убираем заголовок, раскрывающий сервер
		-Server
	}
}

# -----------------------------------------------------------------------------
# Основной сайт по доменному имени магазина (авто-SSL)
# -----------------------------------------------------------------------------
{$SHOP_DOMAIN} {
	import security_headers
	reverse_proxy app:3000
	# Структурированные логи в JSON (удобно для мониторинга)
	log {
		output stdout
		format json
	}
}

# -----------------------------------------------------------------------------
# Fallback для локальной разработки и проверки по IP/без домена (:80)
# Работает, даже если SHOP_DOMAIN не задан реальным доменом.
# -----------------------------------------------------------------------------
:80 {
	import security_headers
	reverse_proxy app:3000
}
